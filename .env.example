# Amadeus API credentials (free tier: https://developers.amadeus.com/)
# Leave empty to run in demo mode with mock data.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Use "test" for the Amadeus sandbox, "production" for live data.
AMADEUS_ENV=test

# SMTP settings for e-mail alerts (optional — falls back to console output).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
