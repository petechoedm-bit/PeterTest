# Amadeus API credentials (free tier: https://developers.amadeus.com/)
# NOTE: Amadeus Self-Service is shutting down 2026-07-17 — use Skyscanner below.
# Leave empty to run in demo mode with mock data.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Use "test" for the Amadeus sandbox, "production" for live data.
AMADEUS_ENV=test

# Skyscanner data via the "Sky Scrapper" RapidAPI proxy (free tier: 20 req/month)
# https://rapidapi.com/apiheya/api/sky-scrapper
SKYSCANNER_RAPIDAPI_KEY=
SKYSCANNER_RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com

# SMTP settings for e-mail alerts (optional — falls back to console output).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
